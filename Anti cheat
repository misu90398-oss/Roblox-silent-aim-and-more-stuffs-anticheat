Players.PlayerAdded:Connect(function(player)
    task.spawn(function()
        local banned, reason = isBanned(player.UserId)
        -- #region agent log
        debugEmit("baseline", "H5", "Untitled-1.ini:player-added:isBanned", "isBanned result", {
            userId = player.UserId,
            banned = banned == true,
            reason = reason,
        })
        -- #endregion
        if banned then
            player:Kick("Baneado permanentemente: " .. (reason or "Cheating"))
            return
        end
        initData(player)
        local data = playerData[player.UserId]
        if data then
            refreshSessionToken(data)
            if reason == "DataStore_unavailable" then
                data.isUnverifiedBanState = true
                addSuspicion(player, "sesion no verificada", 6)
            end
        end
        saveLog(player.UserId, player.Name, "Sesión iniciada", "INFO")

        -- Anti ban-evasión: flag si la cuenta es muy nueva
        if CONFIG.MIN_ACCOUNT_AGE > 0 and player.AccountAge < CONFIG.MIN_ACCOUNT_AGE then
            handleViolation(player,
                ("Cuenta nueva sospechosa: %d días de antigüedad (mín: %d)"):format(
                    player.AccountAge, CONFIG.MIN_ACCOUNT_AGE),
                "new_account"
            )
        end

        player.CharacterAdded:Connect(function(char)
            local d = playerData[player.UserId]
            if d then
                d.lastPos      = nil
                d.lastPosTime  = time()
                d.hitsReceived = 0
                d.lookBuffer   = {}  -- resetear historial al respawnear
                d.airTime      = 0
                d.lastHPDropTs = time()
                refreshSessionToken(d)
            end

            -- ── Detección de Infinite Jump ─────────────────────────────
            local hum2 = char:WaitForChild("Humanoid", 5)
            if not hum2 then return end
            local jumpCount    = 0
            local jumpSecStart = time()
            hum2.Jumping:Connect(function(isActive)
                if not isActive then return end
                local now2 = time()
                if now2 - jumpSecStart >= 1 then
                    jumpCount    = 0
                    jumpSecStart = now2
                end
                jumpCount += 1
                if jumpCount > CONFIG.MAX_JUMPS_PER_SEC then
                    handleViolation(player,
                        ("Infinite jump: %d saltos/s (máx %d)"):format(
                            jumpCount, CONFIG.MAX_JUMPS_PER_SEC),
                        "inf_jump"
                    )
                end
            end)
        end)

        -- Enviar snapshot al admin si corresponde (fusionado del segundo PlayerAdded)
        task.wait(2)
        if isAdmin(player) then sendFullUpdate(player) end
    end)
end)

