local AdminUpdate  = ReplicatedStorage:FindFirstChild("AdminGUI_Update")
local AdminCommand = ReplicatedStorage:FindFirstChild("AdminGUI_Command")

sendFullUpdate = function(admin)
    if not AdminUpdate then return end
    local online = {}
    for _, p in ipairs(Players:GetPlayers()) do
        local d = playerData[p.UserId]
        online[p.Name] = {
            userId    = p.UserId,
            flags     = d and d.flags or 0,
            shots     = d and d.shots or 0,
            headshots = d and d.headshots or 0,
        }
    end
    AdminUpdate:FireClient(admin, {
        type    = "fullUpdate",
        players = online,
        logs    = flagLog,
    })
end

if AdminCommand and AdminCommand:IsA("RemoteFunction") then
    AdminCommand.OnServerInvoke = function(admin, command, targetId)
        if not isAdmin(admin) then
            return { success = false, msg = "Sin permisos de admin." }
        end

        if command == "kick" then
            local t = Players:GetPlayerByUserId(targetId)
            if t then
                t:Kick("Expulsado por admin: " .. admin.Name)
                saveLog(targetId, t.Name, "Kick manual por " .. admin.Name, "WARN")
                return { success = true, msg = t.Name .. " expulsado." }
            end
            return { success = false, msg = "Jugador no encontrado online." }

        elseif command == "ban" then
            local t = Players:GetPlayerByUserId(targetId)
            if t then
                banPlayer(t, "Ban manual por " .. admin.Name)
                return { success = true, msg = t.Name .. " baneado." }
            else
                pcall(function()
                    BanStore:UpdateAsync(tostring(targetId), function()
                        return {
                            banned = true,
                            reason = "Ban manual por " .. admin.Name,
                            time   = os.time(), name = "?",
                        }
                    end)
                end)
                return { success = true, msg = "Ban aplicado (jugador offline)." }
            end

        elseif command == "unban" then
            local ok = unbanPlayer(targetId)
            if ok then
                saveLog(targetId, "?", "Desbaneado por " .. admin.Name, "INFO")
                return { success = true, msg = "Jugador desbaneado." }
            end
            return { success = false, msg = "Error al desbanear." }

        elseif command == "clearFlags" then
            local t = Players:GetPlayerByUserId(targetId)
            if t and playerData[targetId] then
                playerData[targetId].flags = 0
                saveLog(targetId, t.Name, "Flags borradas por " .. admin.Name, "INFO")
                return { success = true, msg = "Flags borradas." }
            end
            return { success = false, msg = "Jugador no encontrado." }

        elseif command == "getLogs" then
            return { success = true, logs = flagLog }
        end

        return { success = false, msg = "Comando desconocido." }
    end
end


