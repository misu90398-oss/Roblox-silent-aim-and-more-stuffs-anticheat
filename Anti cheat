local function debugEmit(runId, hypothesisId, location, message, data)
    local payload = {
        sessionId = "9ac516",
        runId = runId,
        hypothesisId = hypothesisId,
        location = location,
        message = message,
        data = data or {},
        timestamp = math.floor(time() * 1000),
    }
    local wroteLocal = false
    if io and io.open then
        pcall(function()
            local f = io.open("debug-9ac516.log", "a")
            if f then
                f:write(HttpService:JSONEncode(payload), "\n")
                f:close()
                wroteLocal = true
            end
        end)
    end
    if wroteLocal then
        return
    end
    local okReq, reqRes = pcall(function()
        return HttpService:RequestAsync({
            Url = "http://127.0.0.1:7810/ingest/ae5a6435-873d-4a15-9988-be1614de5348",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["X-Debug-Session-Id"] = "9ac516",
            },
            Body = HttpService:JSONEncode(payload),
        })
    end)
    if not okReq then
        warn("[DebugEmit] ingest request failed")
    else
        -- #region agent log
        warn(("[DebugEmit] ingest status=%s body=%s"):format(
            tostring(reqRes and reqRes.StatusCode),
            tostring(reqRes and reqRes.Body)
        ))
        -- #endregion
    end
end

