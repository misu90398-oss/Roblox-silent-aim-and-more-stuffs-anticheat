-- BAN PERMANENTE
-- ================================================
local function banPlayer(player, reason)
    recentBanCache[player.UserId] = time() + CONFIG.RECENT_BAN_CACHE_SEC
    task.spawn(function()
        pcall(function()
            BanStore:UpdateAsync(tostring(player.UserId), function()
                return {
                    banned = true,
                    reason = reason,
                    time   = os.time(),
                    name   = player.Name,
                }
            end)
        end)
    end)
    saveLog(player.UserId, player.Name, "BANEADO: " .. reason, "BAN")
    warn(("[AntiCheat] BAN: %s (%d) - %s"):format(player.Name, player.UserId, reason))
    player:Kick("Baneado permanentemente: " .. reason)
end

local function isBanned(userId)
    local cacheExp = recentBanCache[userId]
    if cacheExp and cacheExp > time() then
        return true, "recent_ban_cache"
    end
    local ok, result = pcall(function() return BanStore:GetAsync(tostring(userId)) end)
    if not ok then
        return false, "DataStore_unavailable"
    end
    return result and result.banned, (result and result.reason or nil)
end

local function unbanPlayer(userId)
    return pcall(function()
        BanStore:UpdateAsync(tostring(userId), function(old)
            local data = old or {}
            data.banned = false
            return data
        end)
    end)
end

-- ================================================
-- SISTEMA DE VIOLACIONES CON SEVERIDAD Y COOLDOWN
-- ================================================
handleViolation = function(player, reason, violationType)
    local data = playerData[player.UserId]
    if not data then return end

    local severity = CONFIG.SEVERITY_THRESHOLDS[violationType] or "MED"

    -- Cooldown por tipo de violación
    local lastTime = data.lastFlagTime[violationType] or 0
    local cooldown = CONFIG.FLAG_COOLDOWN + (getPingMs(player) * CONFIG.FLAG_COOLDOWN_PING_FACTOR)
    if time() - lastTime < cooldown then return end
    data.lastFlagTime[violationType] = time()

    -- LOW: solo consola
    if severity == "LOW" then
        warn(("[AntiCheat] INFO %s - %s"):format(player.Name, reason))
        saveLog(player.UserId, player.Name, reason, "INFO")
        return
    end

    -- MED / HIGH: acumular flag
    data.flags += 1
    saveLog(player.UserId, player.Name, reason, "WARN")
    warn(("[AntiCheat] WARN %s (%d) [%s] - %s [flags:%d]"):format(
        player.Name, player.UserId, severity, reason, data.flags
    ))

    -- Broadcast a admins online
    local AdminUpdate = ReplicatedStorage:FindFirstChild("AdminGUI_Update")
    if AdminUpdate then
        for _, p in ipairs(Players:GetPlayers()) do
            if isAdmin(p) then
                AdminUpdate:FireClient(p, {
                    type   = "newFlag",
                    player = player.Name,
                    userId = player.UserId,
                    reason = reason,
                    flags  = data.flags,
                })
            end
        end
    end

    -- Ban automático
    if data.flags >= CONFIG.FLAGS_TO_BAN then
        banPlayer(player, "Infracciones acumuladas: " .. reason)
        return
    end

    -- Kick por umbral o HIGH+flags previas
    if CONFIG.ACTION == "kick"
    or data.flags >= CONFIG.FLAGS_TO_KICK
    or (severity == "HIGH" and data.flags >= 3) then
        player:Kick("Anti-cheat: " .. reason)
    end
end

