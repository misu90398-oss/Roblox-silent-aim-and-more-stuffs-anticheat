local function clampDot(a)
    return math.clamp(a, -1, 1)
end

local function angleBetween(a, b)
    if a.Magnitude <= 0 or b.Magnitude <= 0 then return 180 end
    return math.deg(math.acos(clampDot(a.Unit:Dot(b.Unit))))
end

local function isFiniteNumber(v)
    return typeof(v) == "number" and v == v and v > -math.huge and v < math.huge
end

local function isFiniteVector3(v)
    return typeof(v) == "Vector3"
        and isFiniteNumber(v.X)
        and isFiniteNumber(v.Y)
        and isFiniteNumber(v.Z)
end

local function getPingMs(player)
    local ok, pingSeconds = pcall(function()
        return player:GetNetworkPing()
    end)
    if not ok or not isFiniteNumber(pingSeconds) then
        return 0
    end
    local pingMs = pingSeconds * 1000
    if pingMs < 0 then return 0 end
    return math.min(pingMs, CONFIG.MAX_PING_LENIENCY_MS)
end

local function pingFactor(player)
    return getPingMs(player) / 1000
end

local function randomToken()
    local a = math.random(100000, 999999)
    local b = math.random(100000, 999999)
    return string.format("%x%x%x", os.time(), a, b)
end

local function refreshSessionToken(data)
    data.sessionToken = randomToken()
    data.tokenExpireTs = time() + CONFIG.SHOOT_TOKEN_TTL
    data.tokenUseNonce = randomToken()
end

local function ensureSessionToken(data)
    if data.sessionToken == "" or time() >= data.tokenExpireTs then
        refreshSessionToken(data)
    end
    return data.sessionToken
end

local function dynamicReactionThreshold(player)
    local threshold = CONFIG.BASE_HUMAN_REACTION_MS + (getPingMs(player) * 0.2)
    return math.clamp(threshold, CONFIG.BASE_HUMAN_REACTION_MS, CONFIG.MAX_HUMAN_REACTION_MS)
end

local function decaySuspicion(data, now)
    local elapsed = math.max(0, now - (data.suspicionLastTs or now))
    data.suspicionLastTs = now
    if elapsed <= 0 then return end
    data.suspicionScore = data.suspicionScore * math.pow(CONFIG.SUSPICION_DECAY_PER_SEC, elapsed)
end

local function pushReactionSample(data, ms)
    table.insert(data.reactionSamples, ms)
    while #data.reactionSamples > 20 do
        table.remove(data.reactionSamples, 1)
    end
end

local function addSuspicion(player, reason, points)
    local data = playerData[player.UserId]
    if not data then return end
    local now = time()
    decaySuspicion(data, now)
    if data.isUnverifiedBanState then
        points *= CONFIG.UNVERIFIED_SCORE_MULTIPLIER
    end
    data.suspicionScore += points

    if data.suspicionScore >= CONFIG.SUSPICION_KICK_SCORE then
        handleViolation(player, ("SilentAim score crítico %.1f: %s"):format(data.suspicionScore, reason), "silent_aim")
        player:Kick("Anti-cheat: patrón de silent aim sostenido")
        return
    end

    if data.suspicionScore >= CONFIG.SUSPICION_FLAG_SCORE then
        handleViolation(player, ("SilentAim score %.1f: %s"):format(data.suspicionScore, reason), "silent_aim")
    elseif data.suspicionScore >= CONFIG.SUSPICION_WARN_SCORE then
        saveLog(player.UserId, player.Name, ("ALERTA SilentAim score %.1f: %s"):format(data.suspicionScore, reason), "WARN")
    end
end

saveLog = function(userId, name, reason, severity)
    local entry = {
        time     = os.time(),
        name     = name,
        userId   = userId,
        reason   = reason,
        severity = severity,
    }

    table.insert(flagLog, 1, string.format(
        "[%s][%s] %s (%d) — %s", ts(), severity, name, userId, reason
    ))
    if #flagLog > MAX_LOG then table.remove(flagLog) end
    table.insert(logBuffer, entry)
end

local function flushLogs()
    if #logBuffer == 0 then return end
    local grouped = {}
    local take = math.min(#logBuffer, CONFIG.LOG_BATCH_SIZE)
    for _ = 1, take do
        local entry = table.remove(logBuffer, 1)
        local key = "log_" .. entry.userId
        grouped[key] = grouped[key] or {}
        table.insert(grouped[key], entry)
    end

    for key, entries in pairs(grouped) do
        task.spawn(function()
            pcall(function()
                LogStore:UpdateAsync(key, function(old)
                    local logs = old or {}
                    for i = 1, #entries do
                        table.insert(logs, 1, entries[i])
                    end
                    while #logs > 50 do table.remove(logs) end
                    return logs
                end)
            end)
        end)
    end
end

