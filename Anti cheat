local function getVisibleAimTarget(player, root)
    local data = playerData[player.UserId]
    local now = time()
    if data and data.targetCache and (now - data.targetCacheTs) <= CONFIG.TARGET_CACHE_TTL then
        return data.targetCache.target, data.targetCache.angle
    end

    local best, bestAngle
    local second, secondAngle
    local origin = root.Position
    local look = root.CFrame.LookVector
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            local och = other.Character
            local oHum = och and och:FindFirstChildOfClass("Humanoid")
            local oRoot = och and och:FindFirstChild("HumanoidRootPart")
            if oHum and oRoot and oHum.Health > 0 then
                local delta = oRoot.Position - origin
                local distance = delta.Magnitude
                if distance > 2 and distance <= 220 then
                    local angle = angleBetween(look, delta)
                    if angle <= 22 then
                        if not bestAngle or angle < bestAngle then
                            second, secondAngle = best, bestAngle
                            best, bestAngle = other, angle
                        elseif not secondAngle or angle < secondAngle then
                            second, secondAngle = other, angle
                        end
                    end
                end
            end
        end
    end

    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {player.Character}

    local function validate(candidate)
        if not candidate then return nil end
        local c = candidate.Character
        local cRoot = c and c:FindFirstChild("HumanoidRootPart")
        if not cRoot then return nil end
        local delta = cRoot.Position - origin
        local hit = workspace:Raycast(origin, delta.Unit * delta.Magnitude, rp)
        if hit and hit.Instance and hit.Instance:IsDescendantOf(c) then
            return candidate
        end
        return nil
    end

    local v1 = validate(best)
    if v1 then
        if data then
            data.targetCache = {target = v1, angle = bestAngle}
            data.targetCacheTs = now
        end
        return v1, bestAngle
    end
    local v2 = validate(second)
    if v2 then
        if data then
            data.targetCache = {target = v2, angle = secondAngle}
            data.targetCacheTs = now
        end
        return v2, secondAngle
    end
    if data then
        data.targetCache = {target = nil, angle = nil}
        data.targetCacheTs = now
    end
    return nil, nil
end

-- Noclip: comprobar si el HumanoidRootPart está dentro de una parte sólida
local function checkNoclip(player)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local overlapParams = OverlapParams.new()
    overlapParams.FilterDescendantsInstances = {char}
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude

    local broad = workspace:GetPartBoundsInRadius(root.Position, 4.5, overlapParams)
    if #broad == 0 then
        return
    end

    local parts = workspace:GetPartsInPart(root, overlapParams)
    local tolerance = CONFIG.NOCLIP_WALL_THRESHOLD + (pingFactor(player) * 3)
    for _, part in ipairs(parts) do
        if part:IsA("BasePart") and part.CanCollide == true
        and part.Transparency < 0.9
        and not part:IsDescendantOf(char) then
            local delta = (root.Position - part.Position).Magnitude
            if delta > (part.Size.Magnitude * 0.75 + tolerance) then
                continue
            end
            handleViolation(player,
                "Posible noclip detectado (dentro de: " .. part.Name .. ")",
                "noclip"
            )
            return
        end
    end
end

local speedTimer   = 0
local noclipTimer  = 0
local aimTimer     = 0

RunService.Heartbeat:Connect(function(dt)
    speedTimer  += dt
    noclipTimer += dt
    aimTimer    += dt

    local doSpeed  = speedTimer  >= CONFIG.SPEED_CHECK_INTERVAL
    local doNoclip = noclipTimer >= CONFIG.NOCLIP_CHECK_INTERVAL
    local doAim    = aimTimer    >= CONFIG.AIM_SAMPLE_INTERVAL

    if not doSpeed and not doNoclip and not doAim then return end

    local now = time()

    local players = Players:GetPlayers()
    local total = #players
    if total == 0 then
        if doSpeed  then speedTimer  = 0 end
        if doNoclip then noclipTimer = 0 end
        if doAim    then aimTimer    = 0 end
        return
    end

    local batch = math.min(CONFIG.ROUND_ROBIN_BATCH_SIZE, total)
    if rrIndex > total then rrIndex = 1 end

    for i = 1, batch do
        local idx = rrIndex + i - 1
        if idx > total then idx -= total end
        local player = players[idx]
        local data = playerData[player.UserId]
        if not data then continue end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then continue end

        -- ── Registro de LookVector (anti silent aim multi-frame) ─────────
        local look = root.CFrame.LookVector
        table.insert(data.lookBuffer, {t = now, v = look})
        -- Mantener solo los últimos 0.5 s
        while data.lookBuffer[1] and now - data.lookBuffer[1].t > 0.5 do
            table.remove(data.lookBuffer, 1)
        end

        if doAim then
            local target, targetAngle = getVisibleAimTarget(player, root)
            if target then
                if data.lastAimTargetId ~= target.UserId then
                    data.lastAimTargetId = target.UserId
                    data.lastAimTargetTs = now
                end
                table.insert(data.recentTargets, {
                    t = now,
                    targetId = target.UserId,
                    angle = targetAngle or 0,
                })
            end
            while data.recentTargets[1] and now - data.recentTargets[1].t > CONFIG.TARGET_MEMORY_WINDOW do
                table.remove(data.recentTargets, 1)
            end
        end

        -- Decaimiento pasivo del score cuando el comportamiento vuelve a normalidad
        decaySuspicion(data, now)

        -- ── Velocidad + fly + traversal de paredes ──────
        if doSpeed then
            local pos = root.Position
            if data.lastPos then
                local elapsed = now - data.lastPosTime
                if elapsed > 0 then
                    local delta = pos - data.lastPos
                    local speed = delta.Magnitude / elapsed

                    -- Tracking de tiempo en el aire (anti-fly lento)
                    local inAir = hum.FloorMaterial == Enum.Material.Air
                    if inAir then
                        data.airTime = data.airTime + elapsed
                    else
                        data.airTime = 0
                    end

                    -- Umbral alto en el aire SOLO durante los primeros MAX_AIR_TIME segundos
                    local maxSpeed = (inAir and data.airTime <= CONFIG.MAX_AIR_TIME)
                        and CONFIG.MAX_SPEED_JUMP
                        or  CONFIG.MAX_SPEED
                    maxSpeed += (getPingMs(player) * 0.03)
                    local vel = root.AssemblyLinearVelocity
                    if inAir and vel.Y < -CONFIG.SPEED_FREEFALL_VEL_Z_THRESHOLD then
                        maxSpeed += 35
                    end

                    if speed > maxSpeed then
                        -- #region agent log
                        debugEmit("baseline", "H4", "Untitled-1.ini:heartbeat:speed", "speed above threshold", {
                            userId = player.UserId,
                            speed = speed,
                            maxSpeed = maxSpeed,
                            inAir = inAir,
                            airTime = data.airTime,
                            pingMs = getPingMs(player),
                            velY = root.AssemblyLinearVelocity.Y,
                        })
                        -- #endregion
                        handleViolation(player,
                            ("Velocidad anómala: %.1f studs/s (máx: %d, airTime: %.1fs)"):format(
                                speed, maxSpeed, data.airTime),
                            "speed"
                        )
                    end

                    -- Noclip via Spherecast: detecta traversal de paredes entre ticks
                    if delta.Magnitude > 0.3 then
                        local sweepParams = RaycastParams.new()
                        sweepParams.FilterDescendantsInstances = {char}
                        sweepParams.FilterType = Enum.RaycastFilterType.Exclude
                        local sweep = workspace:Spherecast(
                            data.lastPos, 1.5, delta, sweepParams
                        )
                        if sweep and sweep.Instance:IsA("BasePart")
                        and sweep.Instance.CanCollide
                        and sweep.Instance.Transparency < 0.9 then
                            handleViolation(player,
                                "Traversal de pared detectado (noclip): " .. sweep.Instance.Name,
                                "noclip"
                            )
                        end
                    end
                end
            end
            data.lastPos     = root.Position
            data.lastPosTime = now
        end

        -- ── Noclip ───────────────────────────────────
        if doNoclip then
            checkNoclip(player)
        end

        -- ── God mode (HP no baja) ────────────────────
        local currentHP = hum.Health
        if currentHP < data.lastHP then
            data.hitsReceived = 0
            data.lastHPDropTs = now
        elseif data.hitsReceived >= CONFIG.GOD_MODE_HIT_THRESHOLD then
            if now - data.lastHPDropTs > CONFIG.GOD_MODE_HEALTH_STALE_SEC then
                handleViolation(player,
                    "Posible god mode: " .. data.hitsReceived .. " impactos sin bajar HP",
                    "god_mode"
                )
                data.hitsReceived = 0
            end
        end
        data.lastHP = currentHP
    end

    rrIndex += batch

    if doSpeed  then speedTimer  = 0 end
    if doNoclip then noclipTimer = 0 end
    if doAim    then aimTimer    = 0 end
end)

