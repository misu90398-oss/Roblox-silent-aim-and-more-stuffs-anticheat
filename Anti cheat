-- ================================================
local boundShootEvents = {}
local ShootTokenFunction = ReplicatedStorage:FindFirstChild("ShootToken")
if not ShootTokenFunction then
    ShootTokenFunction = Instance.new("RemoteFunction")
    ShootTokenFunction.Name = "ShootToken"
    ShootTokenFunction.Parent = ReplicatedStorage
end

local function findRecentTargetSample(data, userId)
    for i = #data.recentTargets, 1, -1 do
        local s = data.recentTargets[i]
        if s.targetId == userId then
            return s
        end
    end
    return nil
end

local function pushWindow(window, now, value, maxAge)
    table.insert(window, {t = now, v = value})
    while window[1] and now - window[1].t > maxAge do
        table.remove(window, 1)
    end
end

local function windowRatio(window)
    if #window == 0 then return 0 end
    local total = 0
    for i = 1, #window do
        total += (window[i].v and 1 or 0)
    end
    return total / #window
end

local function processShoot(player, origin, direction, hitPartName, sourceEventName, token, tokenNonce)
        local data = playerData[player.UserId]
        if not data then return end

        local now = time()
        -- #region agent log
        debugEmit("baseline", "H1", "Untitled-1.ini:processShoot:entry", "processShoot entry", {
            userId = player.UserId,
            sourceEventName = sourceEventName,
            hasToken = token ~= nil,
            hasNonce = tokenNonce ~= nil,
            originType = typeof(origin),
            directionType = typeof(direction),
        })
        -- #endregion
        local expectedToken = ensureSessionToken(data)
        if CONFIG.REQUIRE_SHOOT_TOKEN then
            if token ~= expectedToken then
                -- #region agent log
                debugEmit("baseline", "H1", "Untitled-1.ini:processShoot:token", "token mismatch", {
                    userId = player.UserId,
                    sourceEventName = sourceEventName,
                    expectedTokenLen = #tostring(expectedToken or ""),
                    providedTokenLen = #tostring(token or ""),
                })
                -- #endregion
                addSuspicion(player, "token de disparo invalido", 10)
                return
            end
            if tokenNonce ~= data.tokenUseNonce then
                -- #region agent log
                debugEmit("baseline", "H1", "Untitled-1.ini:processShoot:nonce", "nonce mismatch", {
                    userId = player.UserId,
                    sourceEventName = sourceEventName,
                })
                -- #endregion
                addSuspicion(player, "nonce de disparo invalido", 10)
                return
            end
            data.tokenUseNonce = randomToken()
        elseif token and token ~= expectedToken then
            addSuspicion(player, "token de disparo desfasado", 4)
        end

        -- Rate limiting por ventana y token bucket
        if now - data.shotSecStart >= 1 then
            data.shotsThisSec = 0
            data.shotSecStart = now
        end
        data.shotsThisSec += 1
        local shotDelta = (data.lastShotTs > 0) and (now - data.lastShotTs) or 999
        data.lastShotTs = now

        local elapsedTokens = math.max(0, now - data.shotTokenTs)
        data.shotTokenTs = now
        data.shotTokens = math.min(CONFIG.MAX_SHOOT_RATE, data.shotTokens + (elapsedTokens * CONFIG.MAX_SHOOT_RATE))
        data.shotTokens -= 1

        if data.shotsThisSec > CONFIG.MAX_SHOOT_RATE then
            handleViolation(player,
                "Rate de disparo excesivo: " .. data.shotsThisSec .. "/s",
                "shoot_rate"
            )
            return
        end
        if data.shotTokens < -2 then
            handleViolation(player, "Burst de disparo excesivo", "shoot_rate")
            return
        end

        if not isFiniteVector3(origin) or not isFiniteVector3(direction) or direction.Magnitude < 0.001 then
            handleViolation(player, "Datos de disparo inválidos", "shoot_origin")
            return
        end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local currentLook = root.CFrame.LookVector
        local directionUnit = direction.Unit
        local deviationAllowance = CONFIG.MAX_DIRECTION_DEVIATION + (getPingMs(player) * 0.03)
        local deviation = angleBetween(directionUnit, currentLook)
        if deviation > deviationAllowance then
            -- #region agent log
            debugEmit("baseline", "H2", "Untitled-1.ini:processShoot:deviation", "deviation above allowance", {
                userId = player.UserId,
                deviation = deviation,
                deviationAllowance = deviationAllowance,
                pingMs = getPingMs(player),
            })
            -- #endregion
            addSuspicion(player, ("direccion desvía %.1f° del look"):format(deviation), 8)
            if deviation > deviationAllowance * 1.6 then
                return
            end
        end

        local dist = (origin - root.Position).Magnitude
        if dist > CONFIG.MAX_SHOOT_ORIGIN_DISTANCE then
            handleViolation(player,
                ("Origen de disparo lejano: %.1f studs"):format(dist),
                "shoot_origin"
            )
            return
        end

        
            local alignCurrent = angleBetween(directionUnit, currentLook)

            -- Buscar entrada más antigua (≥ 0.25 s atrás) en el buffer
            local oldEntry = nil
            for i = 1, #data.lookBuffer do
                if now - data.lookBuffer[i].t >= 0.25 then
                    oldEntry = data.lookBuffer[i]
                    break
                end
            end

            if oldEntry then
                local snapAngle  = angleBetween(currentLook, oldEntry.v)
                local alignOld   = angleBetween(directionUnit, oldEntry.v)

                -- Snap brusco + disparo alinea con look nuevo pero NO con el viejo = silent aim
                if snapAngle > CONFIG.MAX_SNAP_ANGLE
                and alignCurrent <= CONFIG.MAX_AIM_ANGLE
                and alignOld     >  CONFIG.MAX_AIM_ANGLE then
                    addSuspicion(player,
                        ("snap %.1f° + mismatch histórico (actual %.1f° / previo %.1f°)"):format(
                            snapAngle, alignCurrent, alignOld),
                        12
                    )
                end
            end

            -- Check de respaldo: ángulo muy desalineado de forma imposible para tiro legítimo
            if alignCurrent > CONFIG.MAX_AIM_ANGLE * 1.6 then
                addSuspicion(player,
                    ("ángulo extremo %.1f° contra cámara visible"):format(alignCurrent),
                    8
                )
            end
        end

        -- Raycast del servidor
        local rp = RaycastParams.new()
        rp.FilterDescendantsInstances = {char}
        rp.FilterType = Enum.RaycastFilterType.Exclude

        local result = workspace:Raycast(origin, directionUnit * CONFIG.MAX_SHOOT_DISTANCE, rp)
        if not result then return end

        local serverPart = result.Instance.Name
        data.lastShotDistance = (result.Position - origin).Magnitude

        -- Comparar hit part (el cliente SIEMPRE debe reportar la parte golpeada)
        if hitPartName == nil then
            addSuspicion(player,
                ("cliente no reporta hitPart; servidor='%s'"):format(serverPart),
                6
            )
            pushWindow(data.mismatchWindow, now, true, 8)
        elseif hitPartName ~= serverPart then
            addSuspicion(player,
                ("hit mismatch cliente='%s' servidor='%s'"):format(tostring(hitPartName), serverPart),
                5
            )
            pushWindow(data.mismatchWindow, now, true, 8)
        else
            pushWindow(data.mismatchWindow, now, false, 8)
        end

        -- Estadísticas aimbot
        data.shots += 1
        local isHeadshot = (serverPart == "Head")
        pushWindow(data.shotWindow, now, isHeadshot, 12)
        if isHeadshot then
            data.headshots += 1
            data.headshotStreak += 1
        else
            data.headshotStreak = 0
        end

        -- Registrar impacto para god mode
        local hitModel  = result.Instance:FindFirstAncestorOfClass("Model")
        local hitPlayer = hitModel and Players:GetPlayerFromCharacter(hitModel)
        if hitPlayer then
            local hitRoot = hitPlayer.Character and hitPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hitRoot then
                local reachDistance = (root.Position - hitRoot.Position).Magnitude
                local reachLimit = CONFIG.MAX_REACH_DISTANCE + (getPingMs(player) * 0.2)
                if reachDistance > reachLimit then
                    addSuspicion(player, ("reach %.1f > %.1f"):format(reachDistance, reachLimit), 10)
                    return
                end
            end

            -- Tiempo de reacción: objetivo adquirido por LOS server-side -> disparo
            local sample = findRecentTargetSample(data, hitPlayer.UserId)
            if sample then
                local reactionMs = math.max(0, (now - sample.t) * 1000)
                pushReactionSample(data, reactionMs)
                local reactionThreshold = dynamicReactionThreshold(player)
                if reactionMs < reactionThreshold then
                    addSuspicion(player,
                        ("reacción %.0fms contra %s"):format(reactionMs, hitPlayer.Name),
                        4
                    )
                end
            end

            -- Tracking invisible: cambio de target con salto angular fuerte sin transición
            local prevTargetId = data.lastAimTargetId
            if prevTargetId and prevTargetId ~= hitPlayer.UserId then
                local prevPlayer = Players:GetPlayerByUserId(prevTargetId)
                local prevRoot = prevPlayer and prevPlayer.Character and prevPlayer.Character:FindFirstChild("HumanoidRootPart")
                local newRoot = hitPlayer.Character and hitPlayer.Character:FindFirstChild("HumanoidRootPart")
                if prevRoot and newRoot then
                    local oldAngle = angleBetween(root.CFrame.LookVector, prevRoot.Position - root.Position)
                    local newAngle = angleBetween(root.CFrame.LookVector, newRoot.Position - root.Position)
                    local switchDelta = math.abs(oldAngle - newAngle)
                    if switchDelta > CONFIG.MAX_TRACKLESS_SWITCH_ANGLE then
                        addSuspicion(player,
                            ("target-switch %.1f° sin tracking progresivo"):format(switchDelta),
                            7
                        )
                    end
                end
            end
            data.lastAimTargetId = hitPlayer.UserId
            data.lastAimTargetTs = now

            local hitData = playerData[hitPlayer.UserId]
            if hitData then
                hitData.hitsReceived += 1
                if hitData.hitsReceived >= CONFIG.GOD_MODE_HIT_THRESHOLD then
                    handleViolation(hitPlayer,
                        "Posible god mode: " .. hitData.hitsReceived .. " impactos sin bajar HP",
                        "god_mode"
                    )
                    hitData.hitsReceived = 0
                end
            end
        end

        -- Evaluar headshot rate
        if data.shots % CONFIG.HEADSHOT_SAMPLE_SIZE == 0 then
            local rate = data.headshots / data.shots
            if rate > CONFIG.MAX_HEADSHOT_RATE then
                addSuspicion(player,
                    ("headshot rate %.0f%% en %d disparos"):format(rate * 100, data.shots),
                    10
                )
            end
        end

        local hsWindowRate = windowRatio(data.shotWindow)
        if #data.shotWindow >= 8 and hsWindowRate >= 0.85 then
            local movingTargetFactor = 0
            if hitPlayer and hitPlayer.Character then
                local hrp = hitPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    movingTargetFactor = hrp.AssemblyLinearVelocity.Magnitude
                end
            end
            if (movingTargetFactor > 12 or shotDelta < 0.2) and data.lastShotDistance >= 45 then
                -- #region agent log
                debugEmit("baseline", "H3", "Untitled-1.ini:processShoot:headshot-window", "headshot window suspicion", {
                    userId = player.UserId,
                    hsWindowRate = hsWindowRate,
                    movingTargetFactor = movingTargetFactor,
                    shotDelta = shotDelta,
                    distance = data.lastShotDistance,
                })
                -- #endregion
                addSuspicion(player, ("headshot window %.0f%%"):format(hsWindowRate * 100), 8)
            end
        end

        local mismatchRate = windowRatio(data.mismatchWindow)
        if #data.mismatchWindow >= 6 and mismatchRate >= 0.5 then
            addSuspicion(player, ("mismatch window %.0f%%"):format(mismatchRate * 100), 6)
        end

        if not sourceEventName then
            addSuspicion(player, "shot sin evento fuente", 3)
        end

        -- Rachas largas de headshots elevan score, pero no banean por sí solas.
        if data.headshotStreak >= CONFIG.HS_STREAK_THRESHOLD then
            addSuspicion(player,
                ("racha de %d headshots consecutivos"):format(data.headshotStreak),
                5
            )
        end
end

local function bindShootRemote(remote)
    if not remote or not remote:IsA("RemoteEvent") then return end
    if boundShootEvents[remote] then return end
    boundShootEvents[remote] = true
    remote.OnServerEvent:Connect(function(player, origin, direction, hitPartName, token, tokenNonce)
        processShoot(player, origin, direction, hitPartName, remote.Name, token, tokenNonce)
    end)
end

for _, remoteName in ipairs(CONFIG.SHOOT_EVENT_NAMES) do
    local remote = ReplicatedStorage:FindFirstChild(remoteName)
    if remote and remote:IsA("RemoteEvent") then
        bindShootRemote(remote)
    end
end

ReplicatedStorage.DescendantAdded:Connect(function(instance)
    if not instance:IsA("RemoteEvent") then return end
    local allowed = CONFIG.ALLOW_UNKNOWN_SHOOT_EVENT
    if not allowed then
        for _, n in ipairs(CONFIG.SHOOT_EVENT_NAMES) do
            if instance.Name == n then
                allowed = true
                break
            end
        end
    end
    if allowed then
        bindShootRemote(instance)
    end
end)

if ShootTokenFunction and ShootTokenFunction:IsA("RemoteFunction") then
    ShootTokenFunction.OnServerInvoke = function(player)
        local data = playerData[player.UserId]
        if not data then return nil end
        local now = time()
        if (now - data.lastTokenRequestTs) < CONFIG.SHOOT_TOKEN_MIN_INTERVAL then
            addSuspicion(player, "token request spam", 3)
            return nil
        end
        data.lastTokenRequestTs = now
        ensureSessionToken(data)
        return {
            token = data.sessionToken,
            nonce = data.tokenUseNonce,
            expireAt = data.tokenExpireTs,
        }
    end
end

